# ─────────────────────────────────────────────────────────────────────────────
# Готовые настройки для запуска на своём компьютере.
# Скопируйте этот файл в .env — править ничего не нужно.
#
#   PowerShell:   Copy-Item .env.local.example .env -Force
#   macOS/Linux:  cp .env.local.example .env
#
# Для боевого сервера этот файл НЕ подходит: там берите .env.example
# и задавайте собственные секреты.
# ─────────────────────────────────────────────────────────────────────────────

# База поднимается командой pnpm db:up. Порт 5433, а не обычный 5432:
# так проект не конфликтует с PostgreSQL, который уже может стоять на машине.
DATABASE_URL="postgresql://bobegim:bobegim@localhost:5433/bobegim?schema=public"

# Локальные домены. Их нужно прописать в файле hosts, иначе браузер их не найдёт.
PORTAL_DOMAIN="bobegim.local"
NEXT_PUBLIC_PORTAL_DOMAIN="bobegim.local"

STORAGE_DIR="./storage"
MAX_UPLOAD_MB="20"

# Секрет заведомо несекретный: он только для локальной машины.
# На сервере обязательно свой: openssl rand -hex 32
SESSION_SECRET="local-development-only-do-not-use-in-production-0000"
SESSION_TTL_DAYS="14"

# Локально сайт работает по http, а cookie с флагом Secure браузер по http
# молча отбрасывает — вход выглядел бы как «неверный пароль».
COOKIE_SECURE=false

TLS_ASK_TOKEN="local-dev"

SUBSCRIPTION_PRICE_KZT="20000"
SUBSCRIPTION_GRACE_DAYS="30"

# ── Карты ──────────────────────────────────────────────────────────────────────
# Ключ геокодера Яндекса: по адресу сада определяются координаты для карты
# в каталоге и блока «Как добраться». Берётся в кабинете разработчика
# (developer.tech.yandex.ru), тариф «HTTP Геокодер». Ключ серверный —
# в браузер не попадает. Без ключа координаты вводятся вручную.
YANDEX_GEOCODER_KEY=

# Ключ JavaScript API Яндекса — интерактивная карта в каталоге портала.
# Этот ключ уезжает в браузер: иначе карту не нарисовать. Тариф бесплатный,
# но с лимитом (100 запросов в сутки), поэтому без него каталог не ломается —
# показывает виджет Яндекса в iframe, тому ключ не нужен вовсе.
YANDEX_MAPS_KEY=
