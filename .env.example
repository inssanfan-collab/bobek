# ── База данных ────────────────────────────────────────────────────────────────
# Значение по умолчанию совпадает с docker-compose.dev.yml (pnpm db:up).
DATABASE_URL="postgresql://bobegim:bobegim@localhost:5432/bobegim?schema=public"

# ── Домены ─────────────────────────────────────────────────────────────────────
# Домен портала. Поддомены садов выдаются как <slug>.<PORTAL_DOMAIN>.
# Для локального запуска поставьте bobegim.local и пропишите домены в hosts
# (см. docs/DEPLOY.md, раздел «Локальная разработка»).
PORTAL_DOMAIN="bobegim.kz"
NEXT_PUBLIC_PORTAL_DOMAIN="bobegim.kz"

# ── Хранилище файлов ───────────────────────────────────────────────────────────
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="20"

# ── Безопасность ───────────────────────────────────────────────────────────────
# Секрет для подписи cookie-сессий и CSRF-токенов. Сгенерировать: openssl rand -hex 32
SESSION_SECRET="change-me-openssl-rand-hex-32"
SESSION_TTL_DAYS="14"
# Оставьте пустым на боевом сервере: cookie сессии получит флаг Secure.
# Значение false нужно только для локального запуска и e2e-тестов по http.
COOKIE_SECURE=

# Caddy спрашивает по этому токену, разрешено ли выпускать сертификат для домена.
TLS_ASK_TOKEN="change-me-too"

# ── Подписка ───────────────────────────────────────────────────────────────────
SUBSCRIPTION_PRICE_KZT="20000"
# Сколько дней после истечения админка работает в режиме «только чтение»,
# прежде чем сад уходит в SUSPENDED.
SUBSCRIPTION_GRACE_DAYS="30"

# ── Карты ──────────────────────────────────────────────────────────────────────
# Ключ геокодера Яндекса: по адресу сада определяются координаты для карты
# в каталоге и блока «Как добраться». Берётся в кабинете разработчика
# (developer.tech.yandex.ru), тариф «HTTP Геокодер». Ключ серверный —
# в браузер не попадает. Без ключа координаты вводятся вручную.
YANDEX_GEOCODER_KEY=

# Ключ JavaScript API Яндекса — интерактивная карта в каталоге портала.
# Этот ключ уезжает в браузер: иначе карту не нарисовать. Тариф бесплатный,
# но с лимитом (100 запросов в сутки), поэтому без него каталог не ломается —
# показывает виджет Яндекса в iframe, тому ключ не нужен вовсе.
YANDEX_MAPS_KEY=
