# ── База данных ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://bobegim:changeme@localhost:5432/bobegim?schema=public"

# ── Домены ─────────────────────────────────────────────────────────────────────
# Домен портала. Поддомены садов выдаются как <slug>.<PORTAL_DOMAIN>.
PORTAL_DOMAIN="bobegim.kz"
# Для локальной разработки удобно переопределить на bobegim.local (см. docs/DEPLOY.md).
NEXT_PUBLIC_PORTAL_DOMAIN="bobegim.kz"

# ── Хранилище файлов ───────────────────────────────────────────────────────────
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="20"

# ── Безопасность ───────────────────────────────────────────────────────────────
# Секрет для подписи cookie-сессий и CSRF-токенов. Сгенерировать: openssl rand -hex 32
SESSION_SECRET="change-me-openssl-rand-hex-32"
SESSION_TTL_DAYS="14"
# Оставьте пустым на боевом сервере: cookie сессии получит флаг Secure.
# Значение false нужно только для локального запуска и e2e-тестов по http.
COOKIE_SECURE=

# Caddy спрашивает по этому токену, разрешено ли выпускать сертификат для домена.
TLS_ASK_TOKEN="change-me-too"

# ── Подписка ───────────────────────────────────────────────────────────────────
SUBSCRIPTION_PRICE_KZT="20000"
# Сколько дней после истечения админка работает в режиме «только чтение»,
# прежде чем сад уходит в SUSPENDED.
SUBSCRIPTION_GRACE_DAYS="30"
