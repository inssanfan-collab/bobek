#!/usr/bin/env python3
"""Закупки сайтов садами на госзакупках → Telegram владельцу (12.10.2026).

Раз в день открывает на old.goszakup.gov.kz два поиска — объявлений
(статусы 220 и 240) и лотов (240): в названии «сайт», заказчик «сад».
Одна закупка в сообщении — одна строка, со сроком окончания приёма. Есть хоть один —
сообщение через бота EduSad тому, кто подключил Telegram в админке портала
(User.telegramChatId): до 10 лотов, новые помечены 🆕. Нет — молчит.

Таймер vsesad-goszakup.timer будит скрипт каждый час с 10:00 до 18:00.
Первая удачная проверка за день — и до завтра он ничего не делает.
Госзакупки бывают недоступны: не ответили — попробует через час, а если
не ответили и в 18:00, придёт «сегодня не открылись», чтобы тишина
не выглядела как «закупок нет».

Токен бота — TELEGRAM_BOT_TOKEN из .env, состояние — /var/lib/edusad/goszakup.json.
Пробный запуск без отправки: vsesad-goszakup --dry-run.
Скрипт копируется на сервер руками, как vsesad-offsite.
"""
import html
import json
import re
import subprocess
import sys
import urllib.parse
import urllib.request
from datetime import datetime
from pathlib import Path

SEARCH = ('https://old.goszakup.gov.kz/ru/search/lots?filter%5Bname%5D=%D1%81%D0%B0%D0%B9%D1%82'
          '&filter%5Bstatus%5D%5B%5D=240&filter%5Bcustomer%5D=%D1%81%D0%B0%D0%B4')
SITE = 'https://old.goszakup.gov.kz'
ABOUT_SITE = re.compile(r'сайт|веб|интернет-ресурс|web', re.I)
ANNOUNCE = ('https://old.goszakup.gov.kz/ru/search/announce?filter%5Bname%5D=%D1%81%D0%B0%D0%B9%D1%82'
            '&filter%5Bcustomer%5D=%D1%81%D0%B0%D0%B4&filter%5Bstatus%5D%5B%5D=220&filter%5Bstatus%5D%5B%5D=240')
LAST_HOUR = 18
STATE = Path('/var/lib/edusad/goszakup.json')
LOG = Path('/var/log/vsesad-goszakup.log')
ENV_FILE = Path('/var/www/vsesad/.env')
UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0 Safari/537.36'


def log(text: str) -> None:
    with LOG.open('a', encoding='utf-8') as f:
        f.write(f'{datetime.now():%Y-%m-%d %H:%M} {text}\n')


def env_value(name: str) -> str:
    for line in ENV_FILE.read_text(encoding='utf-8').splitlines():
        match = re.match(rf'^{name}=(.*)$', line.strip())
        if match:
            return match.group(1).strip().strip('"').strip("'")
    return ''


def owner_chat() -> str:
    url = env_value('DATABASE_URL').split('?')[0]
    out = subprocess.run(
        ['psql', url, '-Atc', 'select "telegramChatId" from "User" where "telegramChatId" is not null order by "createdAt" limit 1'],
        capture_output=True, text=True, check=True, timeout=30,
    )
    return out.stdout.strip()


def send(text: str) -> None:
    body = json.dumps({'chat_id': owner_chat(), 'text': text, 'parse_mode': 'HTML',
                       'disable_web_page_preview': True}).encode()
    request = urllib.request.Request(
        f'https://api.telegram.org/bot{env_value("TELEGRAM_BOT_TOKEN")}/sendMessage',
        data=body, headers={'Content-Type': 'application/json'})
    urllib.request.urlopen(request, timeout=30).read()


def clean(fragment: str) -> str:
    return re.sub(r'\s+', ' ', html.unescape(re.sub(r'<[^>]+>', ' ', fragment))).strip()


def first(pattern: str, text: str) -> str:
    match = re.search(pattern, text, re.S)
    return match.group(1) if match else ''


def fetch_table(url: str) -> list[str]:
    """Строки таблицы результатов поиска (только строки с объявлением)."""
    request = urllib.request.Request(url, headers={'User-Agent': UA})
    page = urllib.request.urlopen(request, timeout=90).read().decode('utf-8', 'replace')
    if 'id="search-result"' not in page:
        raise RuntimeError('на странице нет таблицы результатов — сайт изменился или не ответил')
    table = first(r'<table[^>]*id="search-result"[^>]*>(.*?)</table>', page)
    return [row for row in re.findall(r'<tr[^>]*>(.*?)</tr>', table, re.S) if '/announce/index/' in row]


def announce_id(row: str) -> str:
    return first(r'href="/ru/announce/index/(\d+)"', row)


def fetch_lots() -> list[dict]:
    """Поиск лотов: в названии лота «сайт», заказчик «сад», статус 240."""
    lots = []
    for row in fetch_table(SEARCH):
        cells = re.findall(r'<td[^>]*>(.*?)(?=<td|$)', row, re.S)
        lots.append({
            'id': announce_id(row),
            'lot': clean(first(r'<strong>(.*?)</strong>', row)),
            'title': clean(first(r'/announce/index/\d+"[^>]*>(.*?)</a>', row)),
            'customer': clean(first(r'Заказчик:</b>(.*?)<br', row)),
            'sum': clean(first(r'nowrap="nowrap"><strong>(.*?)</strong>', row)),
            'method': clean(cells[5]) if len(cells) >= 6 else '',
        })
    return lots


def fetch_announces() -> list[dict]:
    """
    Поиск объявлений (статусы 220 и 240). Лоты находятся не все: «сайт» бывает
    в названии объявления, а не лота (14.10.2026 так пропустили закупку),
    поэтому смотрим оба списка. Здесь же — срок окончания приёма заявок.
    """
    found = []
    for row in fetch_table(ANNOUNCE):
        cells = re.findall(r'<td[^>]*>(.*?)(?=<td|$)', row, re.S)
        found.append({
            'id': announce_id(row),
            'number': clean(first(r'<strong>(.*?)</strong>', row)),
            'title': clean(first(r'/announce/index/\d+"[^>]*>(.*?)</a>', row)),
            'customer': clean(first(r'Организатор:</b>(.*?)<br', row)),
            'method': clean(cells[2]) if len(cells) >= 3 else '',
            'end': clean(cells[4]) if len(cells) >= 5 else '',
            'sum': clean(first(r'nowrap="nowrap"><strong>(.*?)</strong>', row)),
        })
    return found


def merge(announces: list[dict], lots: list[dict]) -> list[dict]:
    """Одна закупка — одна запись: объявление и его лоты по номеру объявления."""
    merged: dict[str, dict] = {}
    for item in announces:
        merged[item['id']] = {**item, 'lots': []}
    for lot in lots:
        item = merged.setdefault(lot['id'], {
            'id': lot['id'], 'number': '', 'title': lot['title'], 'customer': lot['customer'],
            'method': lot['method'], 'end': '', 'sum': lot['sum'], 'lots': [],
        })
        item['lots'].append(lot['lot'])
    # Поиск лотов находит «сайт» не только в названии (попадался вывоз мусора) —
    # оставляем закупки, где про сайт сказано в самом названии.
    return [item for item in merged.values() if item['id'] and ABOUT_SITE.search(item['title'])]


def keys_of(item: dict) -> list[str]:
    """Чем закупка помечается как виденная: номер объявления и номера лотов."""
    return [f'a:{item["id"]}', *item['lots']]


def message(items: list[dict], seen: set[str]) -> str:
    e = html.escape
    lines = [f'🏛 <b>Госзакупки: сайты для садов — {len(items)}</b>', '']
    for item in items[:10]:
        new = '' if any(key in seen for key in keys_of(item)) else '🆕 '
        number = item['number'] or ', '.join(item['lots'])
        details = [f'💰 {e(item["sum"])} ₸', e(item['method'])]
        if item['end']:
            details.append(f'приём до {e(item["end"])}')
        details.append(f'№ {e(number)}')
        lines += [f'{new}<a href="{SITE}/ru/announce/index/{e(item["id"])}">{e(item["title"])}</a>',
                  e(item['customer']), ' · '.join(d for d in details if d), '']
    if len(items) > 10:
        lines.append(f'…и ещё {len(items) - 10}.')
    lines.append(f'<a href="{e(ANNOUNCE)}">Все объявления на сайте госзакупок</a>')
    return '\n'.join(lines)


def main() -> None:
    dry = '--dry-run' in sys.argv[1:]
    today = datetime.now().strftime('%Y-%m-%d')
    try:
        state = json.loads(STATE.read_text(encoding='utf-8'))
    except (OSError, ValueError):
        state = {}
    if not dry and state.get('checked') == today:
        return

    # Один из поисков не ответил — работаем по второму; не ответили оба — пробуем через час.
    announces: list[dict] = []
    lots: list[dict] = []
    errors = []
    try:
        announces = fetch_announces()
    except Exception as error:  # noqa: BLE001 — любая неудача сети одинакова
        errors.append(f'объявления: {error}')
    try:
        lots = fetch_lots()
    except Exception as error:  # noqa: BLE001
        errors.append(f'лоты: {error}')
    for error in errors:
        log(f'ошибка: {error}')
    if len(errors) == 2:
        if dry:
            raise RuntimeError('; '.join(errors))
        if datetime.now().hour >= LAST_HOUR and state.get('failed') != today:
            send('🏛 Госзакупки сегодня не открылись — проверить закупки сайтов не получилось. '
                 f'Завтра в 10:00 попробую снова.\n<a href="{html.escape(ANNOUNCE)}">Открыть поиск</a>')
            state['failed'] = today
            STATE.write_text(json.dumps(state, ensure_ascii=False), encoding='utf-8')
        sys.exit(1)

    items = merge(announces, lots)
    seen = set(state.get('seen', []))
    text = message(items, seen) if items else ''
    log(f'найдено: {len(items)}' if items else 'закупок нет')
    if dry:
        print(text or 'Закупок нет — сообщение не отправляется.')
        return
    if text:
        send(text)
    state['checked'] = today
    fresh = [key for item in items for key in keys_of(item) if key not in seen]
    state['seen'] = (list(seen) + fresh)[-500:]
    STATE.write_text(json.dumps(state, ensure_ascii=False), encoding='utf-8')


if __name__ == '__main__':
    main()
