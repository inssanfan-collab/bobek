{
	email {$ACME_EMAIL}

	# Сертификаты для собственных доменов садов выпускаются по требованию.
	# Перед выпуском Caddy спрашивает у приложения, знаем ли мы такой домен, —
	# иначе любой, кто направит свой домен на наш IP, исчерпал бы лимиты Let's Encrypt.
	on_demand_tls {
		ask http://app:3000/api/tls/ask?token={$TLS_ASK_TOKEN}
		interval 2m
		burst 5
	}
}

(site) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# HSTS включайте, только когда убедились, что все домены садов работают по https.
		# Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
}

# Портал и поддомены садов.
# Для *.{$PORTAL_DOMAIN} нужен wildcard-сертификат: он выпускается только через DNS-01,
# поэтому в блок ниже добавьте dns-модуль вашего регистратора либо оставьте
# on-demand выпуск на каждый поддомен отдельно (работает без настройки DNS API).
{$PORTAL_DOMAIN}, www.{$PORTAL_DOMAIN} {
	import site
}

*.{$PORTAL_DOMAIN} {
	import site
}

# Собственные домены садов: конкретные имена заранее неизвестны,
# поэтому обслуживаем любой хост, который подтвердило приложение.
:443 {
	tls {
		on_demand
	}
	import site
}
